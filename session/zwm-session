#!/bin/sh
# zwm X11 session: prepare the environment, then replace this shell with the WM.

export XDG_SESSION_TYPE=x11
export XDG_CURRENT_DESKTOP=zwm
export XDG_SESSION_DESKTOP=zwm

# The WM and the apps it starts need a session bus (notifications, MPRIS, NetworkManager).
runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ] && [ -S "$runtime/bus" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime/bus"
fi
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ] && command -v dbus-run-session >/dev/null 2>&1; then
    exec dbus-run-session -- "$0" "$@"
fi

# Let D-Bus-activated and systemd user services see this display.
command -v dbus-update-activation-environment >/dev/null 2>&1 &&
    dbus-update-activation-environment --systemd DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE

# Without this X shows its default "X" cursor on the empty desktop.
command -v xsetroot >/dev/null 2>&1 && xsetroot -cursor_name left_ptr

if command -v xrdb >/dev/null 2>&1; then
    # Bundled xterm theme first, so ~/.Xresources can override it.
    for f in /usr/local/share/zwm/zwm.Xresources "$(dirname "$0")/zwm.Xresources"; do
        [ -f "$f" ] && { xrdb -merge "$f"; break; }
    done
fi

[ -f "$HOME/.Xresources" ] && command -v xrdb >/dev/null 2>&1 && xrdb -merge "$HOME/.Xresources"

# Put your own startup (polkit agent, wallpaper, picom, ...) in here.
autostart="${XDG_CONFIG_HOME:-$HOME/.config}/zwm/autostart"
[ -x "$autostart" ] && "$autostart" &

# Log next to the other per-user state, and restart the WM if it crashes (it re-adopts the windows
# that are still open). A clean exit - the quit binding - ends the session.
state="${XDG_STATE_HOME:-$HOME/.local/state}/zwm"
mkdir -p "$state" 2>/dev/null
log="$state/zwm.log"
[ -f "$log" ] && [ "$(wc -c <"$log")" -gt 1048576 ] && mv -f "$log" "$log.old"

crashes=0
while :; do
    started=$(date +%s)
    zwm >>"$log" 2>&1
    rc=$?
    [ "$rc" -eq 0 ] && exit 0
    echo "[$(date '+%F %T')] zwm exited with status $rc" >>"$log"
    # More than 5 crashes inside a short window: give up instead of looping forever.
    [ $(( $(date +%s) - started )) -gt 30 ] && crashes=0
    crashes=$((crashes + 1))
    [ "$crashes" -ge 5 ] && exit "$rc"
    sleep 0.3
done
