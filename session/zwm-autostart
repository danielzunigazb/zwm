#!/bin/sh
# zwm autostart (installed to ~/.config/zwm/autostart). The WM runs it right after its first frame,
# once per session, so there is nothing to wait for. Opens Claude Code in ~/Proyectos, resuming the
# last conversation there. Add your own startup (polkit agent, wallpaper, picom, ...) before the exec.

PATH="$HOME/.local/bin:$PATH"
cd "$HOME/Proyectos" 2>/dev/null || cd "$HOME"
setsid -f obsidian >/dev/null 2>&1   # Vault: ~/Obsidian/Workflow
exec xterm -T claude -e sh -c 'claude --continue || exec claude'
